{
  "name": "@poolstatis/sdk",
  "version": "0.3.0",
  "description": "Zero-dependency Poolstatis SDK for Node, immediate browser analytics, engagement, attribution and privacy-bounded experience evidence.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lim5max/poolstatis.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/lim5max/poolstatis/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/lim5max/poolstatis/issues"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "browser-analytics",
    "mcp",
    "poolstatis"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./experience": { "types": "./dist/experience.d.ts", "import": "./dist/experience.js" },
    "./attribution": { "types": "./dist/attribution.d.ts", "import": "./dist/attribution.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js" },
    "./replay": { "types": "./dist/replay.d.ts", "import": "./dist/replay.js" }
  },
  "files": ["dist", "README.md", "MIGRATION.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@rrweb/record": "2.1.1"
  },
  "peerDependenciesMeta": {
    "@rrweb/record": { "optional": true }
  },
  "devDependencies": {
    "@rrweb/record": "2.1.1",
    "@rrweb/types": "2.1.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
