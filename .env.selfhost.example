# Copy to .env or pass with:
# docker compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d --build

POSTGRES_USER=poolsatis
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=poolsatis

POOLSTATIS_ADMIN_PORT=8080
POOLSTATIS_API_PORT=3300
POOLSTATIS_PUBLIC_URL=http://localhost:8080

DATABASE_POOL_MAX=10
INGEST_BUFFER_MAX_EVENTS=1000
INGEST_BUFFER_MAX_DELAY_MS=10
INGEST_BUFFER_MAX_PENDING_EVENTS=50000
QUERY_CACHE_TTL_MS=1000
QUERY_CACHE_MAX_ENTRIES=1000

# Per-process key + project isolation. Cloud deployments should also add a
# shared edge/Redis limiter for global quotas across API replicas.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INGEST_KEY_PER_SECOND=50000
RATE_LIMIT_INGEST_KEY_BURST=100000
RATE_LIMIT_INGEST_PROJECT_PER_SECOND=200000
RATE_LIMIT_INGEST_PROJECT_BURST=400000
RATE_LIMIT_API_KEY_PER_SECOND=3000
RATE_LIMIT_API_KEY_BURST=6000
RATE_LIMIT_API_PROJECT_PER_SECOND=10000
RATE_LIMIT_API_PROJECT_BURST=20000
RATE_LIMIT_MAX_ENTRIES=100000
RATE_LIMIT_MAX_ENTRIES_PER_TENANT=10000
RATE_LIMIT_IDLE_TTL_MS=600000

# Bounded automatic data-retention maintenance.
RETENTION_WORKER_ENABLED=true
RETENTION_INTERVAL_MS=900000
RETENTION_CONTINUATION_DELAY_MS=1000
RETENTION_MAX_CONSECUTIVE_CONTINUATIONS=5
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES=100
RETENTION_MAX_ROWS_PER_RUN=100000
RETENTION_MAX_RUN_MS=5000

# Keep false until the public MCP package/runner is actually published.
POOLSTATIS_MCP_PACKAGE_PUBLISHED=false
